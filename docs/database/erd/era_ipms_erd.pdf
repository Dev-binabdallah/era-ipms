        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ROLES ||--o{ USERS : \&quot;has\&quot;\n\n    USERS ||--o| STAFF_VOLUNTEERS : \&quot;linked to\&quot;\n\n    USERS ||--o{ BENEFICIARIES : \&quot;creates\&quot;\n    USERS ||--o{ DISABILITY_ASSESSMENTS : \&quot;conducts\&quot;\n    USERS ||--o{ HOME_VISITS : \&quot;conducts\&quot;\n    USERS ||--o{ REFERRALS : \&quot;creates\&quot;\n    USERS ||--o{ REFERRAL_FOLLOW_UPS : \&quot;conducts\&quot;\n\n    USERS ||--o{ PROJECTS : \&quot;manages\&quot;\n    USERS ||--o{ ACTIVITIES : \&quot;manages\&quot;\n\n    USERS ||--o{ POULTRY_TRANSACTIONS : \&quot;records\&quot;\n    USERS ||--o{ EGG_PRODUCTION : \&quot;records\&quot;\n    USERS ||--o{ FEED_RECORDS : \&quot;records\&quot;\n    USERS ||--o{ POULTRY_HEALTH_RECORDS : \&quot;records\&quot;\n\n    USERS ||--o{ FARM_CROPS : \&quot;records\&quot;\n    USERS ||--o{ FARM_ACTIVITIES : \&quot;records\&quot;\n    USERS ||--o{ HARVESTS : \&quot;records\&quot;\n    USERS ||--o{ EXPENSES : \&quot;records\&quot;\n    USERS ||--o{ ME_INDICATORS : \&quot;records\&quot;\n\n    BENEFICIARIES ||--o{ DISABILITY_ASSESSMENTS : \&quot;has\&quot;\n    BENEFICIARIES ||--o{ HOME_VISITS : \&quot;receives\&quot;\n    BENEFICIARIES ||--o{ REFERRALS : \&quot;receives\&quot;\n    BENEFICIARIES ||--o{ ACTIVITY_PARTICIPANTS : \&quot;participates\&quot;\n\n    REFERRALS ||--o{ REFERRAL_FOLLOW_UPS : \&quot;has\&quot;\n\n    PROJECTS ||--o{ ACTIVITIES : \&quot;contains\&quot;\n    PROJECTS ||--o{ EXPENSES : \&quot;has\&quot;\n    PROJECTS ||--o{ ME_INDICATORS : \&quot;has\&quot;\n\n    ACTIVITIES ||--o{ ACTIVITY_PARTICIPANTS : \&quot;has\&quot;\n\n    FARM_CROPS ||--o{ FARM_ACTIVITIES : \&quot;has\&quot;\n    FARM_CROPS ||--o{ HARVESTS : \&quot;produces\&quot;\n\n    ROLES {\n        BIGINT role_id PK\n        VARCHAR role_name\n        TEXT description\n        DATETIME created_at\n    }\n\n    USERS {\n        BIGINT user_id PK\n        BIGINT role_id FK\n        VARCHAR username\n        VARCHAR email\n        VARCHAR password_hash\n        BOOLEAN is_active\n        DATETIME last_login\n        DATETIME created_at\n    }\n\n    STAFF_VOLUNTEERS {\n        BIGINT staff_volunteer_id PK\n        BIGINT user_id FK\n        VARCHAR full_name\n        VARCHAR person_type\n        VARCHAR phone\n        VARCHAR email\n        DATE start_date\n        VARCHAR status\n        DATETIME created_at\n    }\n\n    BENEFICIARIES {\n        BIGINT beneficiary_id PK\n        VARCHAR beneficiary_code UK\n        VARCHAR first_name\n        VARCHAR last_name\n        DATE date_of_birth\n        VARCHAR sex\n        VARCHAR location\n        VARCHAR phone\n        DATE registration_date\n        VARCHAR status\n        BIGINT created_by FK\n        DATETIME created_at\n        DATETIME updated_at\n    }\n\n    DISABILITY_ASSESSMENTS {\n        BIGINT assessment_id PK\n        BIGINT beneficiary_id FK\n        DATE assessment_date\n        VARCHAR assessment_type\n        VARCHAR disability_type\n        TEXT needs\n        TEXT assessment_notes\n        BIGINT assessed_by FK\n        DATETIME created_at\n    }\n\n    HOME_VISITS {\n        BIGINT home_visit_id PK\n        BIGINT beneficiary_id FK\n        DATE visit_date\n        BIGINT conducted_by FK\n        VARCHAR purpose\n        TEXT observations\n        TEXT support_provided\n        BOOLEAN follow_up_required\n        TEXT next_action\n        DATETIME created_at\n    }\n\n    REFERRALS {\n        BIGINT referral_id PK\n        BIGINT beneficiary_id FK\n        DATE referral_date\n        VARCHAR referral_destination\n        TEXT reason\n        BIGINT referred_by FK\n        VARCHAR status\n        DATETIME created_at\n    }\n\n    REFERRAL_FOLLOW_UPS {\n        BIGINT follow_up_id PK\n        BIGINT referral_id FK\n        DATE follow_up_date\n        BIGINT conducted_by FK\n        TEXT outcome\n        BOOLEAN service_received\n        TEXT remaining_needs\n        TEXT next_action\n        DATETIME created_at\n    }\n\n    PROJECTS {\n        BIGINT project_id PK\n        VARCHAR project_name\n        TEXT description\n        DATE start_date\n        DATE end_date\n        TEXT objectives\n        VARCHAR status\n        BIGINT responsible_user_id FK\n        DATETIME created_at\n    }\n\n    ACTIVITIES {\n        BIGINT activity_id PK\n        BIGINT project_id FK\n        VARCHAR activity_name\n        DATE activity_date\n        VARCHAR location\n        BIGINT responsible_user_id FK\n        TEXT description\n        VARCHAR status\n        TEXT results\n        DATETIME created_at\n    }\n\n    ACTIVITY_PARTICIPANTS {\n        BIGINT participant_id PK\n        BIGINT activity_id FK\n        BIGINT beneficiary_id FK\n        VARCHAR participant_name\n        VARCHAR participant_type\n        DATETIME created_at\n    }\n\n    POULTRY_TRANSACTIONS {\n        BIGINT poultry_transaction_id PK\n        DATE transaction_date\n        VARCHAR transaction_type\n        INT quantity\n        VARCHAR chicken_type\n        TEXT description\n        BIGINT recorded_by FK\n        DATETIME created_at\n    }\n\n    EGG_PRODUCTION {\n        BIGINT egg_production_id PK\n        DATE production_date\n        INT eggs_produced\n        INT eggs_used\n        INT eggs_sold\n        INT eggs_remaining\n        BIGINT recorded_by FK\n        DATETIME created_at\n    }\n\n    FEED_RECORDS {\n        BIGINT feed_record_id PK\n        DATE record_date\n        VARCHAR feed_source\n        VARCHAR feed_description\n        DECIMAL quantity\n        VARCHAR unit\n        DECIMAL cost\n        BIGINT recorded_by FK\n        DATETIME created_at\n    }\n\n    POULTRY_HEALTH_RECORDS {\n        BIGINT health_record_id PK\n        DATE record_date\n        VARCHAR condition_type\n        INT number_affected\n        TEXT description\n        TEXT action_taken\n        TEXT outcome\n        BIGINT recorded_by FK\n        DATETIME created_at\n    }\n\n    FARM_CROPS {\n        BIGINT crop_id PK\n        VARCHAR crop_name\n        TEXT description\n        DATE planting_date\n        VARCHAR status\n        BIGINT recorded_by FK\n        DATETIME created_at\n    }\n\n    FARM_ACTIVITIES {\n        BIGINT farm_activity_id PK\n        BIGINT crop_id FK\n        DATE activity_date\n        VARCHAR activity_type\n        TEXT description\n        BIGINT conducted_by FK\n        DATETIME created_at\n    }\n\n    HARVESTS {\n        BIGINT harvest_id PK\n        BIGINT crop_id FK\n        DATE harvest_date\n        DECIMAL quantity\n        VARCHAR unit\n        VARCHAR usage\n        TEXT notes\n        BIGINT recorded_by FK\n        DATETIME created_at\n    }\n\n    EXPENSES {\n        BIGINT expense_id PK\n        DATE expense_date\n        VARCHAR category\n        DECIMAL amount\n        TEXT description\n        BIGINT project_id FK\n        VARCHAR expense_area\n        VARCHAR payment_method\n        BIGINT recorded_by FK\n        DATETIME created_at\n    }\n\n    ME_INDICATORS {\n        BIGINT indicator_id PK\n        BIGINT project_id FK\n        VARCHAR indicator_name\n        TEXT description\n        DECIMAL target_value\n        DECIMAL current_value\n        VARCHAR unit\n        DATE start_date\n        DATE end_date\n        BIGINT recorded_by FK\n        DATETIME created_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LKcEze6oUqOtv7xgjTIu-1">
