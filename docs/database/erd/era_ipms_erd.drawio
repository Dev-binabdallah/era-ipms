        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ROLES ||--o{ USERS : has\n    USERS ||--o| STAFF_VOLUNTEERS : linked_to\n\n    USERS ||--o{ BENEFICIARIES : creates\n    USERS ||--o{ DISABILITY_ASSESSMENTS : assesses\n    USERS ||--o{ HOME_VISITS : conducts\n    USERS ||--o{ REFERRALS : creates\n    USERS ||--o{ REFERRAL_FOLLOW_UPS : conducts\n\n    USERS ||--o{ PROJECTS : manages\n    USERS ||--o{ ACTIVITIES : responsible_for\n\n    USERS ||--o{ POULTRY_TRANSACTIONS : records\n    USERS ||--o{ EGG_PRODUCTION : records\n    USERS ||--o{ FEED_RECORDS : records\n    USERS ||--o{ POULTRY_HEALTH_RECORDS : records\n\n    USERS ||--o{ FARM_CROPS : records\n    USERS ||--o{ FARM_ACTIVITIES : conducts\n    USERS ||--o{ HARVESTS : records\n\n    USERS ||--o{ EXPENSES : records\n    USERS ||--o{ ME_INDICATORS : records\n\n    BENEFICIARIES ||--o{ DISABILITY_ASSESSMENTS : has\n    BENEFICIARIES ||--o{ HOME_VISITS : receives\n    BENEFICIARIES ||--o{ REFERRALS : receives\n    BENEFICIARIES ||--o{ ACTIVITY_PARTICIPANTS : participates\n\n    REFERRALS ||--o{ REFERRAL_FOLLOW_UPS : has\n\n    PROJECTS ||--o{ ACTIVITIES : contains\n    PROJECTS ||--o{ EXPENSES : has\n    PROJECTS ||--o{ ME_INDICATORS : has\n\n    ACTIVITIES ||--o{ ACTIVITY_PARTICIPANTS : has\n\n    FARM_CROPS ||--o{ FARM_ACTIVITIES : has\n    FARM_CROPS ||--o{ HARVESTS : produces\n\n    ROLES {\n        BIGINT role_id PK\n        VARCHAR role_name UK\n        TEXT description\n        TIMESTAMP created_at\n    }\n\n    USERS {\n        BIGINT user_id PK\n        BIGINT role_id FK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR username UK\n        VARCHAR email UK\n        VARCHAR password_hash\n        VARCHAR phone\n        TINYINT is_active\n        TIMESTAMP created_at\n    }\n\n    STAFF_VOLUNTEERS {\n        BIGINT staff_volunteer_id PK\n        BIGINT user_id FK\n        VARCHAR full_name\n        VARCHAR person_type\n        VARCHAR phone\n        VARCHAR email\n        DATE start_date\n        VARCHAR status\n        TIMESTAMP created_at\n    }\n\n    BENEFICIARIES {\n        BIGINT beneficiary_id PK\n        VARCHAR beneficiary_code UK\n        VARCHAR first_name\n        VARCHAR last_name\n        DATE date_of_birth\n        VARCHAR sex\n        VARCHAR location\n        VARCHAR phone\n        DATE registration_date\n        VARCHAR status\n        BIGINT created_by FK\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    DISABILITY_ASSESSMENTS {\n        BIGINT assessment_id PK\n        BIGINT beneficiary_id FK\n        DATE assessment_date\n        VARCHAR assessment_type\n        VARCHAR disability_type\n        TEXT needs\n        TEXT assessment_notes\n        BIGINT assessed_by FK\n        TIMESTAMP created_at\n    }\n\n    HOME_VISITS {\n        BIGINT home_visit_id PK\n        BIGINT beneficiary_id FK\n        DATE visit_date\n        BIGINT conducted_by FK\n        VARCHAR purpose\n        TEXT observations\n        TEXT support_provided\n        TINYINT follow_up_required\n        TEXT next_action\n        TIMESTAMP created_at\n    }\n\n    REFERRALS {\n        BIGINT referral_id PK\n        BIGINT beneficiary_id FK\n        DATE referral_date\n        VARCHAR referral_destination\n        TEXT reason\n        BIGINT referred_by FK\n        VARCHAR status\n        TIMESTAMP created_at\n    }\n\n    REFERRAL_FOLLOW_UPS {\n        BIGINT follow_up_id PK\n        BIGINT referral_id FK\n        DATE follow_up_date\n        BIGINT conducted_by FK\n        TEXT outcome\n        TINYINT service_received\n        TEXT remaining_needs\n        TEXT next_action\n        TIMESTAMP created_at\n    }\n\n    PROJECTS {\n        BIGINT project_id PK\n        VARCHAR project_name\n        TEXT description\n        DATE start_date\n        DATE end_date\n        TEXT objectives\n        VARCHAR status\n        BIGINT responsible_user_id FK\n        TIMESTAMP created_at\n    }\n\n    ACTIVITIES {\n        BIGINT activity_id PK\n        BIGINT project_id FK\n        VARCHAR activity_name\n        DATE activity_date\n        VARCHAR location\n        BIGINT responsible_user_id FK\n        TEXT description\n        VARCHAR status\n        TEXT results\n        TIMESTAMP created_at\n    }\n\n    ACTIVITY_PARTICIPANTS {\n        BIGINT participant_id PK\n        BIGINT activity_id FK\n        BIGINT beneficiary_id FK\n        VARCHAR participant_name\n        VARCHAR participant_type\n        TIMESTAMP created_at\n    }\n\n    POULTRY_TRANSACTIONS {\n        BIGINT poultry_transaction_id PK\n        DATE transaction_date&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3Ee9mxsOPQWrVU0HXmA8-1">
